<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view_models="clr-namespace:MVVM_MAUI.ViewModels"
             x:DataType="view_models:BMICalculatorPageViewModel"
             x:Class="MVVM_MAUI.Views.BMICalculatorPage"
             Title="BMICalculatorPage">
    
    <FlexLayout Padding="40" Direction="Column" Wrap="Wrap" JustifyContent="SpaceEvenly">
        <VerticalStackLayout>
            
            <Label Text="BMI" FontSize="60" HorizontalOptions="Center" FontAttributes="Bold" TextColor="DarkBlue" />
            
            <Label Text="Height (cm):" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" />
            <Entry Text="{Binding Height}" FontSize="Large" TextColor="Red" FontAttributes="Bold" />
            <Stepper Value="{Binding Height}" Minimum="20" Maximum="240" HorizontalOptions="Center"/>
            
            <Label Text="Weight (kg):" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" />
            <Entry Text="{Binding Weight}" FontSize="Large" TextColor="Red" FontAttributes="Bold" />
            <Stepper Value="{Binding Weight}" Minimum="10" Maximum="320" HorizontalOptions="Center" />

            <Label Text="BMI Score:" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" />
            <Label Text="{Binding BMIScore}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="25" TextColor="Green"/>
            
            <Label Text="Result:" HorizontalOptions="Center" FontAttributes="Bold" FontSize="20" />
            <Label Text="{Binding BMIResult}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="40" TextColor="Green" />

        </VerticalStackLayout>
    </FlexLayout>
</ContentPage>