<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view_models="clr-namespace:MVVM_MAUI.ViewModels"
             x:Class="MVVM_MAUI.Views.EmployeePage"
             x:DataType="view_models:EmployeePageViewModel"
             Title="EmployeePage">
    <VerticalStackLayout>
        
        <Label Text="Enter Employee Name" />
        <Entry Text="{Binding EmployeeName}" />

        <Label Text="{Binding EmployeeName}" VerticalOptions="Center" FontSize="Large" />

        <Button Text="Save" Command="{Binding SaveCommand}" />

    </VerticalStackLayout>
</ContentPage>