<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVM_MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MVVM_MAUI"
    xmlns:views="clr-namespace:MVVM_MAUI.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MVVM_MAUI">

    <TabBar>
        <ShellContent
            Title="Employee"
            ContentTemplate="{DataTemplate views:EmployeePage}"
            Route="EmployeePage" />

        <ShellContent
            Title="BMI Calculator"
            ContentTemplate="{DataTemplate views:BMICalculatorPage}" 
            Route="BMICalculatorPage" />
    </TabBar>
</Shell>
