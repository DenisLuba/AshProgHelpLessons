<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Login_MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Login_MAUI.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="Login_MAUI">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage" />

    <FlyoutItem Route="HomePage" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent
            Title="Contact"
            ContentTemplate="{DataTemplate pages:ContactPage}" />
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate pages:AboutPage}" />
    </FlyoutItem>
</Shell>
