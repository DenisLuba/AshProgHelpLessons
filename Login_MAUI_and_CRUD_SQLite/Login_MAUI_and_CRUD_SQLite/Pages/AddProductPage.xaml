<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Login_MAUI.Pages.AddProductPage"
             xmlns:view_models="clr-namespace:Login_MAUI.ViewModels"
             x:DataType="view_models:AddProductPageViewModel"
             BackgroundColor="#E8F8F5"
             Title="Product Entry">
    <ScrollView>
        <VerticalStackLayout>
            <Border
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Margin="10"
                Padding="4"
                BackgroundColor="LavenderBlush">
                <VerticalStackLayout Spacing="5" Padding="15" Margin="10">
                    <VerticalStackLayout IsEnabled="False" IsVisible="False">
                        <Label Text="ID" FontSize="Medium" />
                        <Entry Text="{Binding ProductInfo.ProductId}" FontSize="Medium" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Product Name" FontSize="Medium" />
                        <Entry Text="{Binding ProductInfo.ProductName}" FontSize="Medium" />
                        <BoxView HeightRequest="0.5" Color="Gray" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Product Qty" FontSize="Medium" />
                        <Entry Text="{Binding ProductInfo.ProductQuantity}" FontSize="Medium" />
                        <BoxView HeightRequest="0.5" Color="Gray" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Product Price" FontSize="Medium" />
                        <Entry Text="{Binding ProductInfo.ProductPrice}" FontSize="Medium" />
                        <BoxView HeightRequest="0.5" Color="Gray" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, 10, *">
                <Button Text="Save" FontAttributes="Bold" FontSize="Medium" Command="{Binding SaveProductCommand}" WidthRequest="100" HorizontalOptions="End" CornerRadius="10" />
                <Button Grid.Column="2" Text="Cancel" FontSize="Medium" FontAttributes="Bold" BackgroundColor="#DF5252" Command="{Binding CancelCommand}" WidthRequest="100" HorizontalOptions="Start" CornerRadius="10" />
            </Grid>
        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>