<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Login_MAUI.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <Grid RowDefinitions="220, *, 50" BackgroundColor="White">

            <Path Aspect="Fill" Stroke="#fff" Data="m39.805,24.64l717,0l0,315.17149c-67.5,101 -381.5,87.08612 -715,-17.14462l-2,-298.02687z" Fill="#2ECC71"/>

            <VerticalStackLayout>
                <Border Stroke="#dddddddd" StrokeThickness="1" BackgroundColor="SkyBlue" HeightRequest="70" WidthRequest="70" Padding="0" Margin="0,100,0,0" HorizontalOptions="Center" StrokeShape="RoundRectangle 40">
                    <Image Source="https://www.findool.com/images/avatars/avatar.png" />
                </Border>
            </VerticalStackLayout>
            
            <Grid  Grid.Row="1" Margin="20,20,20,0" RowDefinitions="*, 50, 50, Auto, 40, 40, *">
                
                <Label Grid.Row="1" Text="{StaticResource welcome}" HorizontalOptions="Center"  FontSize="Title" FontAttributes="Bold" Padding="0" Margin="0" />
                
                <Label Grid.Row="2" Text="{StaticResource sign_in}" HorizontalOptions="Center" FontSize="Subtitle" />
                
                <VerticalStackLayout Grid.Row="3">
                    <Border Background="Transparent" Stroke="LightGreen" StrokeThickness="1" StrokeShape="RoundRectangle 30" HorizontalOptions="Fill" Padding="0">
                        <HorizontalStackLayout>
                            <Border Background="SkyBlue" HeightRequest="40" WidthRequest="40" Stroke="SkyBlue" StrokeThickness="1" StrokeShape="RoundRectangle 30" Padding="0" Margin="5">
                                <Image Source="https://cdn4.iconfinder.com/data/icons/glyphs/24/icons_user2-256.png" Aspect="Fill" Margin="0" />
                            </Border>
                            <Entry x:Name="entryUserName" ReturnType="Next" Text="{Binding UserName}" Placeholder="Username" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Fill" Margin="0,0,20,0" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Background="Transparent" Stroke="LightGreen" StrokeThickness="1" StrokeShape="RoundRectangle 30" HorizontalOptions="Fill" Padding="0" Margin="0,20,0,0">
                        <HorizontalStackLayout>
                            <Border Background="SkyBlue" HeightRequest="40" WidthRequest="40" Stroke="SkyBlue" StrokeThickness="1" StrokeShape="RoundRectangle 30" Padding="0" Margin="5">
                                <Image Source="https://cdn4.iconfinder.com/data/icons/basic-ui-elements-round/700/09_lock-256.png" Aspect="Fill" Margin="0" />
                            </Border>
                            <Entry x:Name="entryPassword" Text="{Binding Password}" IsPassword="True" Placeholder="Password" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Fill" Margin="0,0,15,0"  ReturnType="Done">
                                <Entry.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                        EventName="Completed"
                                        Command="{Binding LoginCommand}" />
                                </Entry.Behaviors>
                            </Entry>
                        </HorizontalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="Auto,Auto, *" Margin="0,10,0,0">
                        <CheckBox IsChecked="False" />
                        <Label Grid.Column="1" Text="{StaticResource remember_me}" TextColor="DarkGray" FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="{StaticResource forgot_password}" TextColor="#1D8348" FontAttributes="Bold" HorizontalOptions="End" VerticalTextAlignment="Center"/>
                    </Grid>
                    <Button Text="{StaticResource sign_in_btn}" BackgroundColor="#58D68D" TextColor="White" FontAttributes="Bold" CornerRadius="30" WidthRequest="200" Margin="0, 15, 0, 0" Command="{Binding LoginCommand}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0, 60, 0, 0" Spacing="10">
                        <Label Text="{StaticResource new_user}" TextColor="DarkGray" FontSize="Small" />
                        <Label Text="{StaticResource sign_up}" TextColor="#1D8348" FontAttributes="Bold" FontSize="Small" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </ScrollView>


</ContentPage>